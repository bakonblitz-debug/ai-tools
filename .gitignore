# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*~

# Local Claude session/state (keep it out of the public repo). settings.json is the one tracked
# file: it names only public plugins and turns coding mode on for this repo (scripts/coding-mode.sh).
.claude/*
!.claude/settings.json

# context/memory live in the private ai-tools-context repo, never here.
# The old harness/context and harness/memory symlinks were removed 2026-10-27.
harness/
*.bak

# Machine-local config: real paths/hostnames, not secrets, but personal.
# .env.example is the committed, generic template — this is not it.
/.env

# credential-guard's PII files: hashes of his own identifiers and the plain review log.
# Shared by every machine through the share, never committed (hashes of short values can be
# brute-forced back). The guard's selftest fails if git would track them.
config/pii-guard/

# Workspace folders that sit beside this repo. Ignored here so a copy or a
# symlink of either can never be committed to the public repo.
projects/
one-offs/
__pycache__/
