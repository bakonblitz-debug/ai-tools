# context/memory live in the private ai-tools-context repo, not here
# Not `harness/context/` with a trailing slash: that matches directories only,
# and these are symlinks into the private context repo (blobs to git). Without
# the slash both forms stay ignored. They must NOT be committed - a symlink
# checked out on Windows materialises as a text file containing its target path.
harness/context
harness/memory
*.bak

# Bench run artifacts: transcripts and copied fixtures, one tree per run.
# The durable record is harness/bench/scoreboard/results.jsonl, which is tracked.
harness/bench/results/
