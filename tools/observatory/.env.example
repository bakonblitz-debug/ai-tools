# Host dir holding sessions.tsv, usage.tsv and pc/ (mounted read-only)
METRICS_DIR=/path/to/context/metrics
# Local dir for the SQLite file (not a network share)
DB_DIR=/path/to/local/observatory-db
UI_PORT=3400
# Encoded workspace roots and home dirs, comma separated (as seen in the project column)
WORKSPACE_PREFIXES=-Users-alice-www,M-
HOME_PREFIXES=-Users-alice,C--Users-alice
# Timezone for displayed times, e.g. America/Toronto
TZ=
# Receiver: shared secret every Claude Code install sends as x-observatory-key (long random string)
OBSERVATORY_KEY=
# Where the receiver listens; 0.0.0.0 lets the other machine on the LAN send telemetry
RECEIVER_BIND=0.0.0.0
RECEIVER_PORT=4318
# Daily copies of the telemetry DB (it cannot be rebuilt), last 7 kept
BACKUP_DIR=/path/to/backups/observatory
