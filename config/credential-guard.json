      "BROADCAST_CONNECTION", "BROADCAST_DRIVER", "CACHE_DRIVER", "CACHE_STORE", "FILESYSTEM_DISK",
      "QUEUE_CONNECTION", "SESSION_DRIVER", "SESSION_LIFETIME",
      "REDIS_CLIENT", "REDIS_HOST", "REDIS_PORT",
      "MAIL_MAILER", "MAIL_HOST", "MAIL_PORT", "MAIL_ENCRYPTION",
      "VITE_APP_NAME", "NODE_ENV", "PORT"
    ],
    "spotify-prefs": [],
