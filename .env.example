# .env.example — template for .env (machine-local, gitignored).
#
# Copy this to .env and fill in what applies. Every key here is optional:
# every script that reads one has a built-in default and degrades (or SKIPs, in
# health-check.sh) when it is unset. Nothing in this repo requires a .env to exist.
#
# Format: plain KEY=value, unquoted, no shell expansion (`$HOME` is taken
# literally, not expanded). The loader is `set -a; . .env; set +a` —
# there is no parser beyond the shell itself, so keep it to that shape.
#
# Do not commit .env itself — it is gitignored on purpose. This file
# (.env.example) is the one that ships.

# --- Workspace root ---

# Overrides per-OS auto-detection (Mac/Linux $HOME/www, WSL2 /mnt/www, Windows
# /m) outright. Only set this if your layout does not match any of those.
# Read by: scripts/lib-root.sh (detect_root, used by session-todo.sh,
# health-check.sh; also local-ai-setup/learning-tests/run-bench.sh)
#WORKSPACE_ROOT=/path/to/www

# --- Second machine, reached over ssh, for anything git-over-SMB can't do ---
# Leave all three unset for a single-machine setup; every reader treats an
# absent REMOTE_HOST as "no remote configured" and skips rather than fails.

# ssh alias (an entry in ~/.ssh/config) for the second machine.
# Read by: scripts/on-mac.sh, scripts/health-check.sh
#REMOTE_HOST=mac

# Workspace root on that machine, as seen from itself (not your local mount
# point for it — on-mac.sh cd's there over ssh).
# Read by: scripts/on-mac.sh
#REMOTE_WWW=/home/you/www

# PATH entries the remote machine's Homebrew (or equivalent) needs that a
# non-interactive ssh session does not pick up from a profile.
# Read by: scripts/on-mac.sh
#REMOTE_BREW_PATH=/opt/homebrew/bin:/opt/homebrew/sbin

# --- Context tree ---

# Root of the context tree, if it is not at the conventional location this
# repo checks by default (/mnt/www/context/context, then ~/www/context/context).
# Only set this if you have a non-standard layout, or a single-machine setup
# where a fixed path is simpler than the built-in fallback list.
# Read by: plugins/bacon/skills/context-query/context-query.py
#CONTEXT_ROOT=/path/to/context/context

# --- Session digest ---

# Cap on how many open items scripts/session-todo.sh prints before
# truncating.
# Read by: scripts/session-todo.sh
#TODO_MAX=20

# --- Memory sync ---

# Label used in the commit message when scripts/sync-memory.sh commits
# on your behalf. Defaults to `hostname` — set this if you want a stable label
# independent of the machine's actual hostname.
# Read by: scripts/sync-memory.sh
#SYNC_HOST_LABEL=

# --- Hermes (local AI) ---

# Path to Hermes' config.yaml, if it is not at the default Linux location.
# Read by: nothing since sync-skills.sh was retired (2026-10-27); kept for Hermes setups
#HERMES_CONFIG=/home/you/.hermes/.hermes/config.yaml
